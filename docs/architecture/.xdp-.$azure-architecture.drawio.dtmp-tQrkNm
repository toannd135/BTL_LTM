<mxPoint x="610" y="125"/></Array></mxGeometry></mxCell><mxCell id="c13" edge="1" parent="1" source="c4" style="html=1;endArrow=classic;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#D79B00;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;rounded=0;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" target="c9" value="③ sạch → commit (S3 PUT)"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="225"/><mxPoint x="640" y="310"/></Array></mxGeometry></mxCell><mxCell id="c14" edge="1" parent="1" source="c4" style="html=1;endArrow=classic;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#D79B00;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="c6" value="④ metadata + audit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" edge="1" parent="1" source="c3" style="html=1;endArrow=classic;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#0078D4;strokeWidth=2;" target="c5" value="HTTP 8080"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" edge="1" parent="1" source="c5" style="html=1;endArrow=classic;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#D79B00;strokeWidth=2;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" target="c6" value="đọc/ghi"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" edge="1" parent="1" source="c5" style="html=1;endArrow=classic;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#D79B00;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;rounded=0;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" target="c10" value="cách ly / khôi phục"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="524"/><mxPoint x="660" y="400"/></Array></mxGeometry></mxCell><mxCell id="c18" edge="1" parent="1" source="c5" style="html=1;endArrow=classic;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#D79B00;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;rounded=0;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.7;entryX=1;entryY=0.5;" target="c7" value="quét lại (định kỳ / thủ công)"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="560"/><mxPoint x="1000" y="125"/></Array></mxGeometry></mxCell><mxCell id="c19" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FAFAFA;strokeColor=#CCCCCC;align=left;verticalAlign=top;spacing=10;fontSize=11;" value="&lt;b&gt;Luồng tải lên (STOR)&lt;/b&gt;&lt;br&gt;① Client gửi tệp qua kênh dữ liệu PASV; server ghi bản tạm.&lt;br&gt;② Bản tạm được stream sang clamd để quét.&lt;br&gt;③ Sạch → commit vào bucket ftp-files.&lt;br&gt;④ Ghi metadata, trạng thái quét, audit vào PostgreSQL.&lt;br&gt;&lt;br&gt;&lt;b&gt;Nhánh thay thế&lt;/b&gt;&lt;br&gt;• Nhiễm: huỷ bản tạm, trả 550, audit MALWARE, tệp không bao giờ vào kho.&lt;br&gt;• clamd lỗi: vẫn commit với trạng thái PENDING, bị chặn tải khi bật enforce.&lt;br&gt;• Phát hiện nhiễm khi quét lại: admin chuyển tệp sang ftp-files-quarantine.&lt;br&gt;&lt;br&gt;&lt;b&gt;Tải xuống (RETR)&lt;/b&gt;: đọc từ ftp-files, từ chối tệp INFECTED / QUARANTINED." vertex="1"><mxGeometry height="330" width="420" x="1060" y="90" as="geometry"/></mxCell><mxCell id="c20" parent="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;" value="Chú thích" vertex="1"><mxGeometry height="78" width="270" x="1210" y="640" as="geometry"/></mxCell><mxCell id="c21" edge="1" parent="1" style="html=1;endArrow=classic;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#0078D4;strokeWidth=2;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="1222" y="676" as="sourcePoint"/><mxPoint x="1272" y="676" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontSize=10;verticalAlign=middle;" value="Traffic từ Internet (data plane)" vertex="1"><mxGeometry height="18" width="195" x="1280" y="667" as="g