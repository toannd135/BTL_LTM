n:left'&gt;Lớp lọc&lt;/th&gt;&lt;th style='background:#0078D4;color:#fff;padding:4px 8px;text-align:left'&gt;Nguồn&lt;/th&gt;&lt;th style='background:#0078D4;color:#fff;padding:4px 8px;text-align:left'&gt;Cổng&lt;/th&gt;&lt;th style='background:#0078D4;color:#fff;padding:4px 8px;text-align:left'&gt;Hành động&lt;/th&gt;&lt;th style='background:#0078D4;color:#fff;padding:4px 8px;text-align:left'&gt;Mục đích&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;nsg-ftpsrv&lt;/td&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;ssh_allowed_cidr&lt;/td&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;22/TCP&lt;/td&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;Allow&lt;/td&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;SSH quản trị VM-A&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;nsg-ftpsrv&lt;/td&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;ftp_allowed_cidr&lt;/td&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;2121/TCP&lt;/td&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;Allow&lt;/td&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;FTP control&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;nsg-ftpsrv&lt;/td&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;ftp_allowed_cidr&lt;/td&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;50000-50100/TCP&lt;/td&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;Allow&lt;/td&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;FTP passive data&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;nsg-ftpsrv&lt;/td&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;admin_web_allowed_cidr (tuỳ chọn)&lt;/td&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;8080/TCP&lt;/td&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;Allow&lt;/td&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;Trang quản trị&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;nsg-ftpsrv-storage&lt;/td&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;10.20.1.10 (VM-A)&lt;/td&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;22, 8333, 3310/TCP&lt;/td&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;Allow&lt;/td&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;SSH (ProxyCommand), S3, clamd&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;nsg-ftpsrv-storage&lt;/td&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;VirtualNetwork&lt;/td&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;*&lt;/td&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;Deny&lt;/td&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;Chặn mọi máy khác trong VNet&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;nsg-ftpsrv-storage&lt;/td&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;Internet&lt;/td&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;*&lt;/td&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;Deny (mặc định)&lt;/td&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;VM-B không nhận kết nối từ ngoài&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;PostgreSQL firewall&lt;/td&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;IP public VM-A (vm-app), db_allowed_cidr_extra&lt;/td&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;5432/TCP&lt;/td&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;Allow&lt;/td&gt;&lt;td style='border-bottom:1px solid #ddd;padding:3px 8px'&gt;JDBC, bắt buộc TLS&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1"><mxGeometry height="205" width="1180" x="40" y="410" as="geometry"/></mxCell><mxCell id="c18" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;" value="Bí mật (mật khẩu DB, khoá S3, token GHCR) nằm trong ansible-vault, Ansible ghi ra tệp .env quyền 0600 trên VM. Tất cả VM tự tắt lúc 23:00." vertex="1"><mxGeometry height="40" width="1180" x="40" y="625" as="geometry"/></mxCell><mxCell id="c19" parent="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;" value="Chú thích" vertex="1"><mxGeometry height="56" width="270" x="950" y="680" as="geometry"/></mxCell><mxCell id="c20" edge="1" parent="1" style="html=1;endArrow=classic;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#B85450;dashed=1;strokeWidth=2;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="962" y="716" as="sourcePoint"/><mxPoint x="1012" y="716" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontSize=10;verticalAlign=middle;" value="Sao lưu" vertex="1"><mxGeometry height="18" width="195" x="1020" y="707" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>