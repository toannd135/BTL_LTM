# hosts.ini duoc Terraform sinh ra (terraform apply). Mau khi tu viet tay:
[app]
20.0.0.1 ansible_user=azureuser ansible_ssh_private_key_file=~/.ssh/id_rsa

# VM-B khong co SSH ra ngoai: di qua VM-A bang ProxyCommand
[storage]
10.20.1.11 ansible_user=azureuser ansible_ssh_private_key_file=~/.ssh/id_rsa ansible_ssh_common_args='-o ProxyCommand="ssh -W %h:%p -q -i ~/.ssh/id_rsa -o StrictHostKeyChecking=accept-new azureuser@20.0.0.1"'

[ftpserver:children]
app
storage

[ftpserver:vars]
ftp_public_ip=20.0.0.1
storage_private_ip=10.20.1.11
