# {{ ansible_managed }}
# VM-B: kho tep + quet ma doc cho VM-A. Cac cong chi publish tren IP private.
name: storage

services:
  # master + volume + filer + S3 gateway trong mot process
  seaweedfs:
    image: {{ seaweedfs_image }}
    restart: unless-stopped
    command: server -dir=/data -s3 -s3.port=8333 -master.volumeSizeLimitMB=1024
    # weed la PID 1 nen SIGTERM khong toi -> docker stop het 10 s roi SIGKILL (exit 137).
    # init chuyen tiep tin hieu; cho toi 30 s de flush truoc snapshot (disk-snapshot.sh)
    init: true
    stop_grace_period: 30s
    environment:
      AWS_ACCESS_KEY_ID: ${FTP_S3_ACCESS_KEY}
      AWS_SECRET_ACCESS_KEY: ${FTP_S3_SECRET_KEY}
      GOMEMLIMIT: {{ seaweedfs_gomemlimit }}
    mem_limit: {{ seaweedfs_mem_limit }}
    ports:
      - "{{ storage_private_ip }}:8333:8333"
    volumes:
      - ./seaweedfs:/data

  # clamd + freshclam (tu cap nhat chu ky)
  clamd:
    image: {{ clamav_image }}
    restart: unless-stopped
    mem_limit: {{ clamd_mem_limit }}
    ports:
      - "{{ storage_private_ip }}:3310:3310"
    volumes:
      - ./clamav-db:/var/lib/clamav
      - ./config/clamd.conf:/etc/clamav/clamd.conf:ro
    # clamdcheck.sh cua image goi `nc localhost 3310`; localhost co the ra ::1 trong khi clamd chi nghe IPv4
    # => luon bao unhealthy. Ping thang 127.0.0.1. start_period dai vi nap chu ky mat vai phut.
    healthcheck:
      test: ["CMD-SHELL", "[ \"$$(echo PING | nc 127.0.0.1 3310)\" = PONG ]"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 6m
