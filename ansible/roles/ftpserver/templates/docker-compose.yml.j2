# {{ ansible_managed }}
# VM-A (1 GB): chi FTP server + admin-web. Kho tep (SeaweedFS) va quet ma doc (clamd) o VM-B, xem role storage.
name: ftpserver

services:
{% if not ftp_db_host %}
  db:
    image: {{ postgres_image }}
    restart: unless-stopped
    environment:
      POSTGRES_DB: ftpserver
      POSTGRES_USER: ftp
      POSTGRES_PASSWORD: ${FTP_DB_PASSWORD}
    volumes:
      - ./pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ftp -d ftpserver"]
      interval: 5s
      timeout: 3s
      retries: 20

{% endif %}
  ftp:
    image: {{ app_image_registry }}/ftpserver:{{ app_version }}
    restart: unless-stopped
    user: "{{ ftp_app_uid }}:{{ ftp_app_uid }}"
{% if not ftp_db_host %}
    depends_on:
      db:
        condition: service_healthy
{% endif %}
    entrypoint: ["java", "-jar", "ftpserver.jar", "/app/config/ftpserver.conf"]
    environment:
      JAVA_TOOL_OPTIONS: "{{ ftp_java_opts }}"
      FTP_DB_URL: jdbc:postgresql://{{ ftp_db_url_suffix }}
      FTP_DB_USER: ftp
      FTP_DB_PASSWORD: ${FTP_DB_PASSWORD}
      FTP_SEED_PASSWORD: ${FTP_SEED_PASSWORD:-}
{% if ftp_storage == 's3' %}
      FTP_S3_ACCESS_KEY: ${FTP_S3_ACCESS_KEY}
      FTP_S3_SECRET_KEY: ${FTP_S3_SECRET_KEY}
{% endif %}
{% if clamav_enabled %}
      FTP_CLAMD: {{ storage_private_ip }}:3310
      FTP_SCAN_ENFORCE: "{{ ftp_scan_enforce | string | lower }}"
{% endif %}
{% if ftp_tls_enabled %}
      FTP_TLS_KEYSTORE_PASSWORD: ${FTP_TLS_KEYSTORE_PASSWORD}
{% endif %}
    ports:
      - "{{ ftp_control_port }}:{{ ftp_control_port }}"
      - "{{ ftp_pasv_min }}-{{ ftp_pasv_max }}:{{ ftp_pasv_min }}-{{ ftp_pasv_max }}"
    volumes:
      - ./config:/app/config:ro
      - ./certs:/app/certs:ro
{% if ftp_storage != 's3' %}
      - ./ftproot:/app/ftproot
{% endif %}
      - ./logs:/app/logs
      - ./data:/app/data

  admin:
    image: {{ app_image_registry }}/ftpadmin:{{ app_version }}
    restart: unless-stopped
{% if not ftp_db_host %}
    depends_on:
      db:
        condition: service_healthy
{% endif %}
    environment:
      FTP_DB_URL: postgresql://{{ ftp_db_url_suffix }}
      FTP_DB_USER: ftp
      FTP_DB_PASSWORD: ${FTP_DB_PASSWORD}
      FTP_HEALTH_HOST: ftp    # admin-web kiem tra cong FTP (widget suc khoe)
      FTP_HEALTH_PORT: "{{ ftp_control_port }}"
      FTPADMIN_SECRET: ${FTPADMIN_SECRET}
{% if ftp_storage == 's3' %}
      FTP_S3_ENDPOINT: http://{{ storage_private_ip }}:8333
      FTP_S3_BUCKET: {{ ftp_s3_bucket }}
      FTP_S3_ACCESS_KEY: ${FTP_S3_ACCESS_KEY}
      FTP_S3_SECRET_KEY: ${FTP_S3_SECRET_KEY}
{% endif %}
{% if clamav_enabled %}
      FTP_CLAMD: {{ storage_private_ip }}:3310
{% endif %}
    ports:
      - "{{ ftpadmin_bind }}:{{ ftpadmin_port }}:8080"
    volumes:
{% if ftp_storage != 's3' %}
      - ./ftproot:/ftproot
{% endif %}
      - ./logs:/logs
      - ./data:/data
      - ./quarantine:/quarantine
