# {{ ansible_managed }}
control.port={{ ftp_control_port }}
{% if ftp_storage == 's3' %}
# Tep luu trong SeaweedFS (S3 API); khoa truy cap lay tu env FTP_S3_ACCESS_KEY / FTP_S3_SECRET_KEY
storage.type=s3
s3.endpoint=http://{{ storage_private_ip }}:8333
s3.bucket={{ ftp_s3_bucket }}
{% else %}
root.dir=/app/ftproot
{% endif %}
data.port.min={{ ftp_pasv_min }}
data.port.max={{ ftp_pasv_max }}
idle.timeout.seconds=300

# VM Azure nam sau NAT: phan hoi PASV phai tra Public IP
pasv.address={{ ftp_public_ip }}

{% if ftp_tls_enabled %}
tls.keystore=/app/certs/ftps.p12
tls.required={{ ftp_tls_required | string | lower }}
{% endif %}

audit.log=/app/logs/audit.log
# db.url / db.user / db.password lay tu env FTP_DB_* (docker-compose)
db.path=/app/data/ftpserver.db
